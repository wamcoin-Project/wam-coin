# ===========================================================================
#  The WAM mainnet node
# ===========================================================================
#
#      install -m 644 deploy/systemd/wamd-mainnet.service /etc/systemd/system/
#      systemctl daemon-reload
#      systemctl enable --now wamd-mainnet        # on 15 September, not before
#
#  Deliberately NOT enabled before launch. The ExecStartPre below turns that
#  from an instruction into a mechanism: a node started before 2026-09-15
#  runs once, stores a genesis block dated in the future, and then fails at
#  every subsequent start with an error that reads like a clock problem. See
#  scripts/genesis_gate.sh and docs/LAUNCH_DAY.md.
#
#  This unit exists in the repository rather than only on the two hosts,
#  because a machine can be replaced and a shell history cannot be read at
#  midnight.
# ===========================================================================

[Unit]
Description=WAM Coin node (mainnet)
After=network-online.target
Wants=network-online.target
# The node retries forever rather than giving up after a burst of failures:
# on a network with no other operators awake, a node that has stopped trying
# is a node nobody restarts.
StartLimitIntervalSec=0

# If this unit fails, say so. A timer stays active however often the
# service under it fails, and every panel here was reading the timer:
# wam-backup failed nightly from 23 August and looked fine, and
# wam-reorg-watch failed from 03:11 UTC on 1 September and looked fine.
# Both were found by a person going and looking.
OnFailure=wam-alert@%n.service

[Service]
Type=simple

# ExecCondition, and it took three wrong answers to get here. Written down
# because the next person to touch this line will reach for one of them.
#
#   ExecStartPre       fails the unit, and Restart=always restarts a unit
#                      whose ExecStartPre failed. Five refusals a minute on
#                      both hosts, forever. RestartPreventExitStatus= does
#                      not help: it covers the exit status of the *main
#                      service process*, and an ExecStartPre is not that.
#
#   inside ExecStart   as `sh -c 'gate && exec wamd'`. The exit status is now
#                      the main process's, so RestartPreventExitStatus does
#                      apply -- but Type=simple reports the service started
#                      the moment the shell is forked, before the gate has
#                      run, so `systemctl start` returns success either way
#                      and the loop came back through Restart=.
#
#   ExecCondition      what it is for. An exit of 1..254 skips the remaining
#                      commands, leaves the unit NOT failed, and Restart=
#                      never engages. 255 or a signal would mark it failed
#                      and start the loop again, which is why the gate uses
#                      78 and nothing else.
#
# The cost is that before 15 September `systemctl start wamd-mainnet` returns
# success and leaves the node not running. The reason is in the journal every
# time, and after 15 September the condition passes and the question stops
# existing.
ExecCondition=/opt/wam/scripts/genesis_gate.sh mainnet --datadir /root/.wam-mainnet

ExecStart=/opt/wam-current-bin/wamd -chain=main -conf=/root/.wam-mainnet/wam.conf -datadir=/root/.wam-mainnet -printtoconsole
Restart=always
RestartSec=15

# Belt and braces. 78 is EX_CONFIG and the only status genesis_gate.sh
# refuses with, so if it is ever moved back to ExecStart this at least stops
# the loop.
RestartPreventExitStatus=78
StandardOutput=journal
StandardError=journal

# The node writes only inside its datadir, so ProtectSystem=full is enough
# and ProtectHome would break /root/.wam-mainnet.
NoNewPrivileges=true
ProtectSystem=full

# CEILINGS, AND WHY THESE NUMBERS AND NOT THE OLD ONES.
#
# Both of these were set for a network that did not exist yet. MemoryMax=2G
# arrived on 2026-08-29, seventeen days before mainnet opened, inside a commit
# about ElectrumX -- a figure written during setup rather than measured. There
# was no LimitNOFILE at all, which leaves the node on the inherited soft limit
# of 1024 descriptors; Core reserves 150 of those for itself, so the real
# ceiling on connections was about 860 whatever maxconnections said.
#
# On 2026-11-06 the three seeds held 107, 106 and 39 connections against hand
# -set caps of 110, 110 and 39 -- seven free slots between them, on the day
# the hash rate rose 70% and new miners arrived. A node that cannot accept a
# connection is a closed door at the one moment a stranger knocks.
#
# What they are now, derived rather than chosen:
#
#   LimitNOFILE=65536   A connection costs one descriptor. 65536 carries far
#                       more than any plausible maxconnections, costs nothing
#                       when unused, and matches what wam-electrumx.service
#                       has had since the day that lesson was learned there.
#
#   MemoryMax=4G        Measured: the node holds 430 MB on the France host
#                       and 675 MB on US-east at ~110 connections, of which
#                       dbcache=200 and maxmempool=300 are fixed. The marginal
#                       cost of a peer is small; 4G leaves room for six times
#                       today's connection count and for the UTXO set to grow,
#                       on hosts of 8 and 12 GB. It is above physical RAM on
#                       the 2 GB Singapore host, where it simply never binds.
#
# A ceiling that kills is worse than one that slows. redis had no limit at all
# and the kernel killed it twice in four minutes hours before this was written;
# the lesson is not "no limits", it is limits set from what the machine can
# carry, revisited when the machine changes and not when something dies.
LimitNOFILE=65536
MemoryMax=4G

[Install]
WantedBy=multi-user.target
