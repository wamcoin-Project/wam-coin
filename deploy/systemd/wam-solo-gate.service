# ===========================================================================
#  wam-solo-gate -- prove daily that a solved block still reaches a node
# ===========================================================================
#
#  The build gate proves a block can be BUILT: --check asks the node whether
#  the block it just constructed would be accepted, and hashes nothing. It
#  cannot prove the block is ever delivered, and on 2026-09-26 delivery was
#  what was broken -- a man solved height 7838 and the miner discarded it.
#
#  This mines two blocks for real on a private regtest chain, with the
#  binaries that are actually installed on this machine, and requires the
#  node to accept both. On our own hardware, never in CI: mining on a hosted
#  build service is against the terms of every one of them.
#
#  It is a few seconds of one core on a throwaway chain whose difficulty is
#  the lowest the consensus rules allow.
# ===========================================================================
[Unit]
Description=Prove that a solved block still reaches the node
Documentation=https://github.com/wamcoin-Project/wam-coin/blob/main/scripts/solo_gate.sh
OnFailure=wam-alert@%n.service

[Service]
Type=oneshot

# AND IT RUNS AS NOBODY, WHICH THE RELEASE NOTES SAID AND THE UNIT DID NOT.
#
# v0.1.15's notes described the solo_gate fix as two halves: verify against
# the fingerprint this repository holds, AND run as nobody. The first half
# shipped. The second did not exist anywhere -- no User=, no DynamicUser=,
# no setpriv, no runuser, in the script or in this unit -- so every day, on
# a timer, on a host carrying a mainnet node, this downloaded release
# tarballs, extracted them and executed wamd, wam-cli and wam-miner as root.
#
# The fingerprint check means the executed code must be signed by the project
# key, so this was never the arbitrary-code hole the original report was
# about. What was missing is exactly the containment the notes claimed:
# nothing stood between a verified binary and the whole machine if that
# binary were ever compromised at source, or exploited by the chain data it
# processes on its throwaway regtest.
#
# Found by Radenlingga on 2026-11-26, in the working tree and in the tag
# object, against the sentence that promised it.
#
# DynamicUser gives a transient unprivileged account with no home, no shell
# and no existence between runs -- stronger than a named `nobody`, which
# other services on the host may share. StateDirectory and the paths below
# follow it automatically.
DynamicUser=yes
Environment=HOME=%S/wam-solo-gate
WorkingDirectory=/opt/wam
ExecStart=/usr/bin/bash /opt/wam/scripts/solo_gate.sh

# It writes its own alarm where the ops panel already counts them, and
# removes it again when the next run passes.
# Both are declared as StateDirectory rather than only granted through
# ReadWritePaths, because under DynamicUser systemd must own and chown them
# for the transient account -- a path merely made writable stays owned by
# root and the gate could not write its alarm. The panel's other writer is
# root, which is unaffected by the ownership.
StateDirectory=wam-solo-gate wam-reorg
ReadWritePaths=/var/lib/wam-reorg /var/lib/wam-solo-gate
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes

# Never at the expense of the chain. This machine serves a node and a miner;
# a gate that slows either of them would be bought at the wrong price.
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
